ARG TAG_NAME="dev"

# Build the alpine gcc image
FROM alpine:latest AS alpine-gcc
RUN apk add \
	gcc musl-dev \
	make && apk cache clean

# Build the library and starlord
FROM alpine-gcc AS build-c
WORKDIR /bot
COPY ./bot .
RUN make -C connection release
RUN make -C starlord release

FROM ghcr.io/42core-team/game-server:${TAG_NAME} AS game

# Create the release image
FROM alpine-gcc AS release
RUN apk add \
	git \
	curl \
	python3 py3-pip \
	bash && apk cache clean && python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip setuptools && pip install norminette

# COPY .bashrc /root/.bashrc
COPY --from=game /core/game /core/game
COPY --from=build-c /bot/starlord/starlord /core/starlord
COPY --from=build-c /bot/connection/inc/con_lib.h core/con_lib.h
COPY --from=build-c /bot/connection/con_lib.a /core/con_lib.a

# Create .bashrc in /root/ directory by curling from URL
RUN curl -o /root/.bashrc https://raw.githubusercontent.com/42core-team/.shellrc/refs/heads/main/.bashrc

SHELL ["/bin/bash", "-c"]
ENV SHELL=/bin/bash
