ARG TAG_NAME="dev"

FROM ubuntu:noble AS ubuntu-gcc
ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && \
    apt install -y git build-essential libcurl4 && \
    rm -rf /var/lib/apt/lists/*

FROM ghcr.io/42core-team/game-server:${TAG_NAME} AS game
FROM ghcr.io/42core-team/connection-lib:${TAG_NAME} AS connection

FROM ubuntu-gcc AS release

# COPY .bashrc /root/.bashrc
COPY --from=game /core/core /core/core
COPY --from=game /core/data /core/data
COPY --from=connection /connection/core_lib.h /core/core_lib.h
COPY --from=connection /connection/con_lib.a /core/con_lib.a

